  }

  /* =========================================
     HEADER VAULT ICON — ITEM SECURED
  ========================================= */

  .tfv-cart-icon-secured {
    position: relative;
    animation:
      tfvCartIconSecure
      720ms
      cubic-bezier(.2, .8, .2, 1)

  .tfv-product-page button:focus-visible,
  .tfv-product-page a:focus-visible {
    outline: 2px solid #f7dc94;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tfv-cart-icon-secured,
    .tfv-cart-icon-secured::after,
    .tfv-cart-icon-secured svg,
    .product-gallery__main-image,
    .product-gallery__sheen,
    .product-intelligence-strip,
    .product-intelligence-strip__signal,
    .product-vault-status__led,
    .add-to-cart-btn,
    .add-to-cart-btn::before,
    .add-to-cart-btn__icon,
    .product-secured-toast,

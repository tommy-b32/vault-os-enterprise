  /* =========================================
     PRODUCT VAULT OPERATOR
  ========================================= */

  .product-intelligence-strip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 22px;
    padding: 12px 14px;
    overflow: hidden;
    color: #ffffff;
    background:
      linear-gradient(
        135deg,
        rgba(197, 157, 95, 0.075),
        rgba(255, 255, 255, 0.018)
      );
    border: 1px solid rgba(197, 157, 95, 0.24);
    border-radius: 10px;
    transition:
      border-color 260ms ease,
      box-shadow 260ms ease,
      background 260ms ease;
  }

  .product-intelligence-strip::after {
    content: "";
    position: absolute;
    top: -42px;
    right: -42px;
    width: 90px;
    height: 90px;
    pointer-events: none;
    background: rgba(197, 157, 95, 0.08);
    border-radius: 50%;
    filter: blur(28px);
  }

  .product-intelligence-strip__signal {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    color: #080808;
    background: linear-gradient(135deg, #ad7d3d, #f7dc94, #9d6b2e);
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 900;
    box-shadow: 0 0 16px rgba(197, 157, 95, 0.14);
  }

  .product-intelligence-strip__content {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
  }

  .product-intelligence-strip__content small {
    color: var(--product-gold);
    font-size: 6.5px;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .product-intelligence-strip__content strong {
    margin-top: 3px;
    color: #ffffff;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .product-intelligence-strip__content > span {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .product-intelligence-strip.is-scanning {
    border-color: rgba(247, 220, 148, 0.48);
    box-shadow: 0 0 24px rgba(197, 157, 95, 0.1);
  }

  .product-intelligence-strip.is-scanning
  .product-intelligence-strip__signal {
    color: var(--product-gold);
    background: rgba(197, 157, 95, 0.08);
    border: 1px solid rgba(197, 157, 95, 0.3);
    animation: productIntelligenceScan 620ms ease-in-out infinite;
  }

  .product-intelligence-strip.is-verified {
    background:
      linear-gradient(
        135deg,
        rgba(74, 222, 128, 0.055),
        rgba(255, 255, 255, 0.018)
      );
    border-color: rgba(74, 222, 128, 0.22);
  }

  .product-intelligence-strip.is-verified::after {
    background: rgba(74, 222, 128, 0.07);
  }

  .product-intelligence-strip.is-verified
  .product-intelligence-strip__signal {
    color: #07140b;
    background: #4ade80;
    box-shadow: 0 0 16px rgba(74, 222, 128, 0.14);
  }

  .product-intelligence-strip.is-bundle {
    border-color: rgba(247, 220, 148, 0.36);
    box-shadow: 0 0 22px rgba(197, 157, 95, 0.06);
  }

  .product-intelligence-strip.is-closed {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.11);
    box-shadow: none;
  }

  .product-intelligence-strip.is-closed::after {
    display: none;
  }

  .product-intelligence-strip.is-closed
  .product-intelligence-strip__signal {
    color: rgba(255, 255, 255, 0.58);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }

  /* =========================================
     VAULT OPERATOR — SAVINGS CELEBRATION
  ========================================= */

  .product-intelligence-strip.is-celebrating {
    min-height: 218px;
    align-items: stretch;
    border-color: rgba(247, 220, 148, 0.48);
    box-shadow:
      0 14px 34px rgba(0, 0, 0, 0.34),
      0 0 28px rgba(197, 157, 95, 0.14);
  }

  .product-intelligence-strip.is-celebrating::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -42%;
    z-index: 8;
    width: 24%;
    pointer-events: none;
    opacity: 0;
    transform: skewX(-18deg);
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(247, 220, 148, 0.42),
        transparent
      );
    animation:
      productOperatorCelebrationSweep
      820ms
      980ms
      ease forwards;
  }

  .product-intelligence-strip.is-celebrating
  > .product-intelligence-strip__signal,
  .product-intelligence-strip.is-celebrating
  > .product-intelligence-strip__content {
    opacity: 0;
    pointer-events: none;
  }

  .product-operator-celebration {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 18px;
    text-align: center;
  }

  .product-intelligence-strip.is-celebrating
  .product-operator-celebration {
    display: flex;
    animation:
      productOperatorCelebrationEnter
      400ms
      cubic-bezier(.2, .8, .2, 1)
      both;
  }

  .product-operator-celebration__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.07);
    border: 1px solid rgba(74, 222, 128, 0.24);
    border-radius: 50%;
    box-shadow: 0 0 28px rgba(74, 222, 128, 0.12);
  }

  .product-operator-celebration__circle,
  .product-operator-celebration__tick {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .product-operator-celebration__circle {
    stroke-width: 1.5;
    stroke-dasharray: 139;
    stroke-dashoffset: 139;
    animation: productOperatorCircleDraw 600ms ease forwards;
  }

  .product-operator-celebration__tick {
    stroke-width: 3;
    stroke-dasharray: 27;
    stroke-dashoffset: 27;
    animation: productOperatorTickDraw 340ms 390ms ease forwards;
  }

  .product-operator-celebration__eyebrow {
    margin-top: 15px;
    color: #4ade80;
    font-size: 7px;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(5px);
    animation: productOperatorCopyEnter 340ms 500ms ease forwards;
  }

  .product-operator-celebration__saving {
    display: block;
    min-width: 220px;
    margin-top: 7px;
    color: #ffffff;
    font-family: "Playfair Display", serif;
    font-size: 1.45rem;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(8px);
    text-shadow: 0 0 24px rgba(74, 222, 128, 0.15);
    animation:
      productOperatorSavingEnter
      420ms
      610ms
      cubic-bezier(.2, .8, .2, 1)
      forwards;
  }

  .product-operator-celebration__supporting {
    display: block;
    margin-top: 7px;
    color: rgba(255, 255, 255, 0.46);
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0;
    animation: productOperatorSupportingEnter 340ms 790ms ease forwards;
  }

  @keyframes productOperatorCelebrationSweep {
    0% { left: -42%; opacity: 0; }
    18% { opacity: 1; }
    100% { left: 124%; opacity: 0; }
  }

  @keyframes productOperatorCelebrationEnter {
    from { opacity: 0; transform: scale(0.985); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes productOperatorCircleDraw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes productOperatorTickDraw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes productOperatorCopyEnter {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes productOperatorSavingEnter {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes productOperatorSupportingEnter {
    to { opacity: 1; }
  }

  /* =========================================
     VARIANT SELECTORS
  ========================================= */

  .product-selectors {
    display: grid;
    gap: 20px;
    margin-bottom: 22px;
  }

  .selector-wrapper {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .selector-wrapper__label {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    width: 100%;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .selector-wrapper__selected {

{{ 'vault-os-brain.js' | asset_url | script_tag }}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign featured_media = selected_variant.featured_media | default: product.featured_media
  assign selected_price = selected_variant.price
  assign selected_compare_price = selected_variant.compare_at_price

  assign product_on_sale = false
  if selected_compare_price > selected_price
    assign product_on_sale = true
  endif

  assign qualifies_for_offer = false
  if product.tags contains '2-for-70' or product.tags contains '2 for 70' or product.tags contains '2 For 70'
    assign qualifies_for_offer = true
  endif

  assign tfv_product_cart_items = 0
  assign tfv_product_vaultcare_active = false
  assign tfv_product_qualifying_items = 0

  for cart_item in cart.items
    if cart_item.product.handle == 'returns-label'
      assign tfv_product_vaultcare_active = true
    else
      assign tfv_product_cart_items = tfv_product_cart_items | plus: cart_item.quantity

      if cart_item.product.tags contains '2-for-70'
        assign tfv_product_qualifying_items = tfv_product_qualifying_items | plus: cart_item.quantity
      endif
    endif
  endfor

  assign tfv_product_qualifying_pairs = tfv_product_qualifying_items | divided_by: 2
  assign tfv_product_unpaired_items = tfv_product_qualifying_items | modulo: 2
  assign tfv_product_secured_saving = tfv_product_qualifying_pairs | times: 10
-%}

<section
  class="tfv-product-page product-section--{{ section.id }}"
  data-tfv-cart-items="{{ tfv_product_cart_items }}"
  data-tfv-vaultcare-active="{% if tfv_product_vaultcare_active %}true{% else %}false{% endif %}"
  data-tfv-qualifying-items="{{ tfv_product_qualifying_items }}"
  data-tfv-qualifying-pairs="{{ tfv_product_qualifying_pairs }}"
  data-tfv-unpaired-items="{{ tfv_product_unpaired_items }}"
  data-tfv-secured-saving="{{ tfv_product_secured_saving }}"
  style="
    --product-bg: {{ section.settings.bg_color }};
    --product-text: {{ section.settings.text_color }};
    --product-gold: {{ section.settings.accent_color }};
    background: var(--product-bg);
    color: var(--product-text);
  "
>
  <div class="container tfv-product-container">

    <!-- =========================================
         BREADCRUMB
    ========================================== -->

    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>

      <span>/</span>

      <a href="{{ product.collections.first.url | default: routes.collections_url }}">
        {{ product.collections.first.title | default: 'Collections' }}
      </a>

      <span>/</span>

      <span>{{ product.title }}</span>
    </nav>

    <div class="product-page__grid">

      <!-- =========================================
           MEDIA VAULT
      ========================================== -->

      <div class="product-gallery">
        <div class="product-gallery__status">
          <span class="product-gallery__status-led"></span>
          Product Verification File
        </div>

        <div
          class="product-gallery__main"
          id="main-image-wrap"
        >
          {%- if featured_media -%}
            {%- if featured_media.media_type == 'image' -%}
              <img
                src="{{ featured_media | image_url: width: 1600 }}"
                alt="{{ featured_media.alt | default: product.title | escape }}"
                id="main-product-image"
                class="product-gallery__main-image"
                loading="eager"
                fetchpriority="high"
                width="{{ featured_media.width | default: 1200 }}"
                height="{{ featured_media.height | default: 1500 }}"
              >
            {%- else -%}
              <img
                src="{{ product.featured_image | image_url: width: 1600 }}"
                alt="{{ product.title | escape }}"
                id="main-product-image"
                class="product-gallery__main-image"
                loading="eager"
                fetchpriority="high"
                width="1200"
                height="1500"
              >
            {%- endif -%}
          {%- endif -%}

          <div id="main-product-video" class="product-gallery__main-video"></div>

          <span class="product-gallery__frame" aria-hidden="true"></span>
          <span class="product-gallery__sheen" aria-hidden="true"></span>

          {%- unless selected_variant.available -%}
            <div class="product-gallery__closed-badge" id="product-closed-badge">
              Vault Closed
            </div>
          {%- endunless -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs-outer">
            <button
              class="thumb-arrow thumb-arrow--left"
              type="button"
              onclick="scrollThumbs(-220)"
              aria-label="View previous product media"
            >
              &#8249;
            </button>

            <div class="product-gallery__thumbs-wrapper">
              <div class="product-gallery__thumbs">
                {%- for media in product.media -%}
                  <button
                    type="button"
                    class="product-gallery__thumb {% if media.id == featured_media.id %}active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-media-type="{{ media.media_type }}"

                    {%- if media.media_type == 'image' -%}
                      data-image-filename="{{ media.src | split: '/' | last | split: '?' | first | split: '.' | first }}"
                      onclick="changeImage('{{ media | image_url: width: 1600 }}', this)"
                    {%- else -%}
                      onclick="changeToVideo({{ media.id }}, '{{ media.media_type }}', '{{ media.sources[0].url }}', this)"
                    {%- endif -%}
                  >
                    {%- if media.media_type == 'image' -%}
                      <img
                        src="{{ media | image_url: width: 220 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        width="90"
                        height="90"
                        loading="eager"
                      >
                    {%- else -%}
                      <div class="product-gallery__video-thumb">
                        {%- if media.preview_image -%}
                          <img
                            src="{{ media.preview_image | image_url: width: 220 }}"
                            alt="Product video"
                            width="90"
                            height="90"
                          >
                        {%- endif -%}

                        <span aria-hidden="true">▶</span>
                      </div>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>

            <button
              class="thumb-arrow thumb-arrow--right"
              type="button"
              onclick="scrollThumbs(220)"
              aria-label="View next product media"
            >
              &#8250;
            </button>

            <div class="product-gallery__thumbs-fade" aria-hidden="true"></div>
          </div>
        {%- endif -%}
      </div>

      <!-- =========================================
           PRODUCT INVENTORY PANEL
      ========================================== -->

      <div class="product-info">
        <div class="product-info__panel">
          {%- form 'product', product, id: 'product-form', class: 'vault-product-form' -%}
            <input
              type="hidden"
              name="id"
              id="variant-id"
              value="{{ selected_variant.id }}"
            >

            <!-- =========================================
                 PRODUCT VAULT OPERATOR
            ========================================== -->

            <div
              class="
                product-intelligence-strip
                {% if selected_variant.available %}
                  {% if qualifies_for_offer %}
                    is-bundle
                  {% else %}
                    is-verified
                  {% endif %}
                {% else %}
                  is-closed
                {% endif %}
              "
              id="product-intelligence-strip"
              data-offer-eligible="{% if qualifies_for_offer %}true{% else %}false{% endif %}"
              role="status"
              aria-live="polite"
            >
              <span
                class="product-intelligence-strip__signal"
                id="product-intelligence-strip-signal"
                aria-hidden="true"
              >
                {%- if selected_variant.available -%}
                  ✓
                {%- else -%}
                  ○
                {%- endif -%}
              </span>

              <span class="product-intelligence-strip__content">
                <small>Vault Operator · Savings Monitor</small>

                <strong id="product-intelligence-strip-title">
                  {%- if selected_variant.available -%}
                    {%- if qualifies_for_offer -%}
                      Bundle Eligible
                    {%- else -%}
                      Variant Verified
                    {%- endif -%}
                  {%- else -%}
                    Vault Closed
                  {%- endif -%}
                </strong>

                <span id="product-intelligence-strip-detail">
                  {%- if selected_variant.available -%}
                    {%- if qualifies_for_offer -%}
                      This item qualifies for the 2 For £70 Vault Bundle.
                    {%- else -%}
                      Ready for secure checkout.
                    {%- endif -%}
                  {%- else -%}
                    Selected {{ selected_variant.title }} is currently sold out. Choose another size or colour to continue.
                  {%- endif -%}
                </span>
              </span>

              <div
                class="product-operator-celebration"
                id="product-operator-celebration"
                aria-hidden="true"
              >
                <div class="product-operator-celebration__icon" aria-hidden="true">
                  <svg width="54" height="54" viewBox="0 0 54 54">
                    <circle
                      class="product-operator-celebration__circle"
                      cx="27"
                      cy="27"
                      r="22"
                    ></circle>
                    <path
                      class="product-operator-celebration__tick"
                      d="M17 28.5 24 35l14-16"
                    ></path>
                  </svg>
                </div>

                <span class="product-operator-celebration__eyebrow">
                  Vault Bundle Activated
                </span>

                <strong
                  class="product-operator-celebration__saving"
                  id="product-operator-celebration-saving"
                >
                  £10 Saving Secured
                </strong>

                <span
                  class="product-operator-celebration__supporting"
                  id="product-operator-celebration-supporting"
                >
                  1 Bundle Active
                </span>
              </div>
            </div>


            {%- unless product.has_only_default_variant -%}
              <div class="product-selectors">
                {%- for option in product.options_with_values -%}
                  <fieldset
                    class="selector-wrapper"
                    data-option-position="{{ option.position }}"
                  >
                    <legend class="selector-wrapper__label">
                      <span>{{ option.name }}</span>

                      <span
                        class="selector-wrapper__selected"
                        data-selected-option="{{ option.position }}"
                      >
                        {{ option.selected_value }}
                      </span>
                    </legend>

                    <div class="option-buttons">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="option-btn {% if option.selected_value == value %}selected{% endif %}"
                          onclick="selectOption(this, '{{ value | escape }}')"
                          data-value="{{ value | escape }}"
                          aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          <p class="product-info__brand">
            {{ section.settings.brand_label }}
          </p>

          <h1 class="product-info__title">
            {{ product.title }}
          </h1>

          <div class="product-info__price-wrap" aria-live="polite">
            <span class="product-info__price" id="product-current-price">
              {{ selected_price | money }}
            </span>

            <span
              class="product-info__compare-price"
              id="product-compare-price"
              {% unless product_on_sale %}hidden{% endunless %}
            >
              {{ selected_compare_price | money }}
            </span>
          </div>

            <!-- =========================================
                 PRODUCT VAULT STATUS
            ========================================== -->

            <div
              class="product-vault-status {% unless selected_variant.available %}product-vault-status--closed{% endunless %}"
              id="product-vault-status"
              aria-live="polite"
            >
              <div class="product-vault-status__header">
                <div class="product-vault-status__identity">
                  <span class="product-vault-status__led" aria-hidden="true"></span>

                  <div>
                    <span class="product-vault-status__kicker">
                      Product Vault Status
                    </span>

                    <strong id="product-vault-status-title">
                      {%- if selected_variant.available -%}
                        Variant Verified
                      {%- else -%}
                        Variant Unavailable
                      {%- endif -%}
                    </strong>
                  </div>
                </div>

                <span
                  class="product-vault-status__state"
                  id="product-vault-status-text"
                >
                  {%- if selected_variant.available -%}
                    Available
                  {%- else -%}
                    Vault Closed
                  {%- endif -%}
                </span>
              </div>

              <div class="product-vault-status__checks">
                <div>
                  <span class="product-vault-status__check">✓</span>
                  <span>
                    <small>Variant</small>
                    <strong id="product-vault-variant-check">
                      Selection verified
                    </strong>
                  </span>
                </div>

                <div>
                  <span
                    class="
                      product-vault-status__check
                      {% unless selected_variant.available %}
                        product-vault-status__check--unavailable
                      {% endunless %}
                    "
                    id="product-vault-inventory-icon"
                  >
                    {%- if selected_variant.available -%}✓{%- else -%}○{%- endif -%}
                  </span>

                  <span>
                    <small>Inventory</small>
                    <strong id="product-vault-inventory-check">
                      {%- if selected_variant.available -%}
                        Ready to secure
                      {%- else -%}
                        Currently unavailable
                      {%- endif -%}
                    </strong>
                  </span>
                </div>

                <div>
                  <span class="product-vault-status__check">✓</span>
                  <span>
                    <small>Dispatch</small>
                    <strong>Free 48hr delivery included</strong>
                  </span>
                </div>

                <div>
                  <span class="product-vault-status__check product-vault-status__check--optional">○</span>
                  <span>
                    <small>Protection</small>
                    <strong>VaultCare available</strong>
                  </span>
                </div>
              </div>
            </div>

            <div class="purchase-section">
              <button
                type="submit"
                name="add"
                class="add-to-cart-btn"
                {% unless selected_variant.available %}disabled{% endunless %}
              >
                <span class="add-to-cart-btn__icon" aria-hidden="true">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <circle cx="12" cy="12" r="8.5"></circle>
                    <circle cx="12" cy="12" r="2.3"></circle>
                    <path d="M12 3.5v6"></path>
                    <path d="M12 14.5v6"></path>
                    <path d="M3.5 12h6"></path>
                    <path d="M14.5 12h6"></path>
                  </svg>
                </span>

                <span id="add-to-cart-text">
                  {%- if selected_variant.available -%}
                    Secure Item
                  {%- else -%}
                    Vault Closed
                  {%- endif -%}
                </span>

                <span
                  class="add-to-cart-btn__divider"
                  aria-hidden="true"
                ></span>

                <span class="btn-price" id="button-product-price">
                  {{ selected_price | money }}
                </span>
              </button>

              <div class="product-form-message" id="product-form-message" aria-live="polite"></div>

              <div class="dynamic-checkout-wrap">
                {{ form | payment_button }}
              </div>
            </div>
          {%- endform -%}

          <div class="product-description-panel">
            <button
              class="product-description-panel__trigger"
              type="button"
              aria-expanded="true"
              onclick="toggleProductDescription(this)"
            >
              <span>Product Intelligence</span>
              <span class="product-description-panel__symbol">−</span>
            </button>

            <div class="description product-description-panel__content">
              {{ product.description }}
            </div>
          </div>

          <div class="product-security-strip">
            <div>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>

              <span>
                <strong>Vault Verified</strong>
                Checked before dispatch
              </span>
            </div>

            <div>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M3 12h18"></path>
                <path d="m14 5 7 7-7 7"></path>
              </svg>

              <span>
                <strong>Secure Dispatch</strong>
                Free 48hr delivery
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="product-secured-toast"
    id="product-secured-toast"
    role="status"
    aria-live="polite"
  >
    <span class="product-secured-toast__icon">✓</span>

    <span>
      <strong>Item Secured</strong>
      Added to your vault
    </span>
  </div>
</section>

<style>
  /* =========================================
     FOUNDATION
  ========================================= */

  .tfv-product-page {
    min-height: 80vh;
    padding: 34px 0 80px;
  }

  .tfv-product-container {
    position: relative;
  }

  .product-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, 0.47);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .product-breadcrumb a:hover {
    color: #f7dc94;
  }

  .product-breadcrumb > span:not(:last-child) {
    color: var(--product-gold);
  }

  .product-breadcrumb > span:last-child {
    color: rgba(255, 255, 255, 0.78);
  }

  .product-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
    gap: clamp(34px, 5vw, 72px);
    align-items: start;
  }

  /* =========================================
     PRODUCT GALLERY
  ========================================= */

  .product-gallery {
    min-width: 0;
  }

  .product-gallery__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.48);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .product-gallery__status-led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--product-gold);
    box-shadow: 0 0 11px rgba(197, 157, 95, 0.7);
  }

  .product-gallery__main {
    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(197, 157, 95, 0.08),
        transparent 45%
      ),
      #111111;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 15px;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.33),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .product-gallery__main-image {
    display: block;
    width: 100%;
    height: auto;
    min-height: 480px;
    object-fit: cover;
    transition:
      opacity 200ms ease,
      transform 750ms cubic-bezier(.2, .8, .2, 1);
  }

  .product-gallery__main:hover .product-gallery__main-image {
    transform: scale(1.012);
  }

  .product-gallery__main-video {
    display: none;
    width: 100%;
  }

  .product-gallery__main-video video {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-gallery__frame {
    position: absolute;
    inset: 10px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 9px;
    pointer-events: none;
  }

  .product-gallery__sheen {
    position: absolute;
    top: -15%;
    bottom: -15%;
    left: -50%;
    z-index: 3;
    width: 28%;
    opacity: 0;
    pointer-events: none;
    transform: skewX(-18deg);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.03),
      rgba(247, 220, 148, 0.16),
      rgba(255, 255, 255, 0.03),
      transparent
    );
  }

  .product-gallery__main:hover .product-gallery__sheen {
    animation: productGallerySheen 1100ms ease forwards;
  }

  .product-gallery__closed-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 5;
    padding: 8px 12px;
    color: rgba(255, 255, 255, 0.74);
    background: rgba(5, 5, 5, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  /* =========================================
     THUMBNAILS
  ========================================= */

  .product-gallery__thumbs-outer {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
  }

  .product-gallery__thumbs-wrapper {
    flex: 1;
    overflow-x: auto;
    padding: 3px 0 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--product-gold) #171717;
    -webkit-overflow-scrolling: touch;
  }

  .product-gallery__thumbs-wrapper::-webkit-scrollbar {
    height: 3px;
  }

  .product-gallery__thumbs-wrapper::-webkit-scrollbar-track {
    background: #171717;
  }

  .product-gallery__thumbs-wrapper::-webkit-scrollbar-thumb {
    background: var(--product-gold);
  }

  .product-gallery__thumbs {
    display: flex;
    gap: 10px;
    width: max-content;
  }

  .product-gallery__thumb {
    position: relative;
    width: 82px;
    height: 82px;
    flex: 0 0 82px;
    overflow: hidden;
    padding: 0;
    background: #151515;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    cursor: pointer;
    opacity: 0.65;
    transition:
      opacity 220ms ease,
      border-color 220ms ease,
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .product-gallery__thumb:hover,
  .product-gallery__thumb.active {
    opacity: 1;
    border-color: var(--product-gold);
    transform: translateY(-2px);
    box-shadow: 0 0 18px rgba(197, 157, 95, 0.13);
  }

  .product-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .product-gallery__video-thumb span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #ffffff;
    font-size: 1.25rem;
    text-shadow: 0 2px 8px #000000;
  }

  .thumb-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    padding: 0;
    color: var(--product-gold);
    background: #141414;
    border: 1px solid rgba(197, 157, 95, 0.55);
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.25rem;
    transition:
      color 220ms ease,
      background 220ms ease,
      transform 180ms ease;
  }

  .thumb-arrow:hover {
    color: #080808;
    background: var(--product-gold);
  }

  .thumb-arrow:active {
    transform: scale(0.94);
  }

  .product-gallery__thumbs-fade {
    position: absolute;
    top: 0;
    right: 38px;
    width: 42px;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      to right,
      transparent,
      var(--product-bg)
    );
  }

  /* =========================================
     INVENTORY PANEL
  ========================================= */

  .product-info {
    min-width: 0;
  }

  .product-info__panel {
    position: sticky;

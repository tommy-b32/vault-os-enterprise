  }

  .product-info__title {
    margin: 0 0 15px;
    color: var(--product-text);
    font-family: "Playfair Display", serif;
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.025em;
  }

  .product-info__price-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 23px;
  }

  .product-info__price {
    color: #f7dc94;
    font-size: 1.55rem;
    font-weight: 800;
    text-shadow: 0 0 18px rgba(197, 157, 95, 0.18);
  }

  .product-info__compare-price {

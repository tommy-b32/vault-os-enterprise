    box-shadow:
      0 0 10px rgba(74, 222, 128, 0.82),
      0 0 22px rgba(74, 222, 128, 0.24);
  }

  .product-vault-status.is-verified .product-vault-status__state {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.06);
    border-color: rgba(74, 222, 128, 0.22);

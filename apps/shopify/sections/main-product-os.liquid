      opacity: 0;
    }
  }

  @keyframes productButtonSheen {
    0% {
      left: -45%;
      opacity: 0;
    }

    20% {
      opacity: 1;
    }

    100% {
      left: 125%;
      opacity: 0;
    }
  }

  @keyframes productIntelligenceScan {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.88);
    }

    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes productStatusScanning {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.88);
    }

    50% {
      opacity: 1;
      transform: scale(1.18);
    }
  }

  @keyframes productStatusPulse {

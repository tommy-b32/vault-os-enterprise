  .product-vault-status__check--optional {
    color: var(--product-gold);
    background: rgba(197, 157, 95, 0.08);
    border: 1px solid rgba(197, 157, 95, 0.24);
    box-shadow: none;
  }

  .product-vault-status__check--unavailable {
  color: rgba(255, 255, 255, 0.58);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: none;
}

  .product-vault-status__checks small,
  .product-vault-status__checks strong {
    display: block;
  }

  .product-vault-status__checks small {
    color: rgba(255, 255, 255, 0.3);
    font-size: 6.5px;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .product-vault-status__checks strong {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .product-vault-status.is-scanning {
    border-color: rgba(247, 220, 148, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 0 30px rgba(197, 157, 95, 0.13);
  }

  .product-vault-status.is-scanning .product-vault-status__led {
    animation: productStatusScanning 620ms ease-in-out infinite;
  }

  .product-vault-status.is-verified {
    border-color: rgba(74, 222, 128, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),

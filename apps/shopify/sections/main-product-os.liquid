    padding: 7px 9px;
    color: #f7dc94;
    background: rgba(197, 157, 95, 0.08);
    border: 1px solid rgba(197, 157, 95, 0.28);
    border-radius: 999px;
    font-size: 7px;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;

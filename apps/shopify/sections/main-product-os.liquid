      opacity: 0.4;
      transform: scale(0.88);
    }

    50% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  function scrollThumbs(amount) {
    const wrapper = document.querySelector(
      '.product-gallery__thumbs-wrapper'
    );

    if (!wrapper) return;

    wrapper.scrollBy({
      left: amount,
      behavior: 'smooth'
    });
  }

  function changeImage(src, thumb) {
    const mainImage = document.getElementById(
      'main-product-image'
    );

    const videoWrap = document.getElementById(
      'main-product-video'
    );

    if (!mainImage || !videoWrap) return;

    videoWrap.style.display = 'none';
    videoWrap.innerHTML = '';

    mainImage.style.display = 'block';
    mainImage.src = src;

    document
      .querySelectorAll('.product-gallery__thumb')
      .forEach((item) => {
        item.classList.remove('active');
      });

    if (thumb) {
      thumb.classList.add('active');
    }
  }

  function changeToVideo(
    mediaId,
    mediaType,
    videoSrc,
    thumb
  ) {
    const mainImage = document.getElementById(
      'main-product-image'
    );

    const videoWrap = document.getElementById(
      'main-product-video'
    );

    if (!mainImage || !videoWrap || !videoSrc) return;

    mainImage.style.display = 'none';
    videoWrap.style.display = 'block';

    videoWrap.innerHTML =
      '<video src="' +
      videoSrc +
      '" controls autoplay playsinline style="width:100%;height:auto;display:block;"></video>';

    document
      .querySelectorAll('.product-gallery__thumb')
      .forEach((item) => {
        item.classList.remove('active');
      });

    if (thumb) {
      thumb.classList.add('active');
    }
  }

  function getSelectedProductConfiguration() {
    const selectedValues = Array.from(
      document.querySelectorAll('.option-btn.selected')
    )
      .map((button) => button.dataset.value)
      .filter(Boolean);

    return selectedValues.length
      ? selectedValues.join(' / ')
      : 'Selected configuration';
  }

  function clearVaultOperatorTimers() {
    if (!Array.isArray(window.tfvVaultOperatorTimers)) {
      window.tfvVaultOperatorTimers = [];
    }

    window.tfvVaultOperatorTimers.forEach((timer) => {
      window.clearTimeout(timer);
    });

    window.tfvVaultOperatorTimers = [];
  }

  function queueVaultOperatorUpdate(callback, delay) {
    const timer = window.setTimeout(callback, delay);

    window.tfvVaultOperatorTimers.push(timer);

    return timer;
  }

  function getVaultOperatorMemory() {
    const fallback = {
      viewedProducts: [],
      productsViewed: 0,
      bundleUnlocked: false,
      highestSaving: 0,
      vaultCareSeen: false,
      securedItems: 0
    };

    try {
      const stored =
        window.sessionStorage.getItem(
          'tfvVaultOperatorMemory'
        );

      if (!stored) return fallback;

      return {
        ...fallback,
        ...JSON.parse(stored)
      };
    } catch (error) {
      return fallback;
    }
  }

  function saveVaultOperatorMemory(memory) {
    try {
      window.sessionStorage.setItem(
        'tfvVaultOperatorMemory',
        JSON.stringify(memory)
      );
    } catch (error) {
      console.warn(
        '[Vault Operator] Session memory unavailable:',
        error
      );
    }
  }

  function registerVaultOperatorProductView() {
    const memory =
      getVaultOperatorMemory();

    const productKey =
      window.location.pathname;

    if (
      !memory.viewedProducts.includes(
        productKey
      )
    ) {
      memory.viewedProducts.push(
        productKey
      );

      memory.productsViewed =
        memory.viewedProducts.length;
    }

    saveVaultOperatorMemory(
      memory
    );

    return memory;
  }

  function updateVaultOperatorMemoryFromContext(
    context
  ) {
    const memory =
      getVaultOperatorMemory();

    memory.bundleUnlocked =
      memory.bundleUnlocked ||
      context.qualifyingPairs > 0;

    memory.highestSaving =
      Math.max(
        memory.highestSaving || 0,
        context.securedSaving || 0
      );

    memory.vaultCareSeen =
      memory.vaultCareSeen ||
      context.vaultCareActive;

    memory.securedItems =
      Math.max(
        memory.securedItems || 0,
        context.cartItems || 0
      );

    saveVaultOperatorMemory(
      memory
    );

    return memory;
  }

  function getProductPageContext() {
    const page = document.querySelector(
      '.tfv-product-page'
    );

    const intelligenceStrip =
      document.getElementById(
        'product-intelligence-strip'
      );

    let returningVisitor = false;

    try {
      returningVisitor =
        window.localStorage.getItem(
          'tfvProductOsKnownVisitor'
        ) === 'true';
    } catch (error) {
      returningVisitor = false;
    }

    return {
      cartItems: Number(
        page && page.dataset.tfvCartItems
          ? page.dataset.tfvCartItems
          : 0
      ),

      vaultCareActive:
        Boolean(
          page &&
          page.dataset.tfvVaultcareActive === 'true'
        ),

      offerEligible:
        Boolean(
          intelligenceStrip &&
          intelligenceStrip.dataset.offerEligible === 'true'
        ),

      qualifyingItems: Number(
        page && page.dataset.tfvQualifyingItems
          ? page.dataset.tfvQualifyingItems
          : 0
      ),

      qualifyingPairs: Number(
        page && page.dataset.tfvQualifyingPairs
          ? page.dataset.tfvQualifyingPairs
          : 0
      ),

      unpairedItems: Number(
        page && page.dataset.tfvUnpairedItems
          ? page.dataset.tfvUnpairedItems
          : 0
      ),

      securedSaving: Number(
        page && page.dataset.tfvSecuredSaving
          ? page.dataset.tfvSecuredSaving
          : 0
      ),

      returningVisitor
    };
  }

  function markProductVisitorKnown() {
    try {
      window.localStorage.setItem(
        'tfvProductOsKnownVisitor',
        'true'
      );
    } catch (error) {
      console.warn(
        '[Vault Operator] Visitor storage unavailable:',
        error
      );
    }
  }


  function updateProductBundleContext(
    qualifyingItems,
    qualifyingPairs
  ) {
    const page = document.querySelector(
      '.tfv-product-page'
    );

    if (!page) return;

    const safeItems = Math.max(
      0,
      Number(qualifyingItems) || 0
    );

    const safePairs = Math.max(
      0,
      Number(qualifyingPairs) || 0
    );

    page.dataset.tfvQualifyingItems =
      String(safeItems);

    page.dataset.tfvQualifyingPairs =
      String(safePairs);

    page.dataset.tfvUnpairedItems =
      String(safeItems % 2);

    page.dataset.tfvSecuredSaving =
      String(safePairs * 10);
  }

  function animateProductSavingCount(
    element,
    targetSaving,
    duration = 460
  ) {
    return new Promise((resolve) => {
      if (!element) {
        resolve();
        return;
      }

      const reducedMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

      if (reducedMotion) {
        element.textContent =
          `£${targetSaving} Saving Secured`;

        resolve();
        return;
      }

      const startTime =
        performance.now();

      function updateCount(currentTime) {
        const elapsed =
          currentTime - startTime;

        const progress =
          Math.min(elapsed / duration, 1);

        const eased =
          1 - Math.pow(1 - progress, 3);

        const currentValue =
          Math.round(targetSaving * eased);

        element.textContent =
          `£${currentValue} Saving Secured`;

        if (progress < 1) {
          window.requestAnimationFrame(
            updateCount
          );

          return;
        }

        resolve();
      }

      window.requestAnimationFrame(
        updateCount
      );
    });
  }

  let tfvProductCelebrationRunning = false;
  let tfvProductCelebrationPairs = 0;
  let tfvPendingBrainMessage = null;

  async function runProductBundleCelebration(
    qualifyingPairs
  ) {
    const strip = document.getElementById(
      'product-intelligence-strip'
    );

    const celebration = document.getElementById(
      'product-operator-celebration'
    );

    const saving = document.getElementById(
      'product-operator-celebration-saving'
    );

    const supporting = document.getElementById(
      'product-operator-celebration-supporting'
    );

    if (
      !strip ||
      !celebration ||
      qualifyingPairs <= 0
    ) {
      return;
    }

    /*
     * Prevent duplicate cart/product events from restarting
     * or instantly cancelling the same celebration.
     */
    if (
      tfvProductCelebrationRunning &&
      qualifyingPairs <= tfvProductCelebrationPairs
    ) {
      return;
    }

    tfvProductCelebrationRunning = true;
    tfvProductCelebrationPairs =
      qualifyingPairs;

    clearVaultOperatorTimers();

    if (saving) {
      saving.textContent =
        '£0 Saving Secured';
    }

    if (supporting) {
      supporting.textContent =
        `${qualifyingPairs} ${
          qualifyingPairs === 1
            ? 'Bundle Active'
            : 'Bundles Active'
        }`;
    }

    celebration.setAttribute(
      'aria-hidden',
      'false'
    );

    /*
     * Remove and re-add the class so every new bundle
     * reliably restarts all CSS keyframe animations.
     */
    strip.classList.remove(
      'is-scanning',
      'is-verified',
      'is-bundle',
      'is-closed',
      'is-celebrating'
    );

    void strip.offsetWidth;

    strip.classList.add(
      'is-celebrating'
    );

    await new Promise((resolve) => {
      window.setTimeout(resolve, 120);
    });

    await animateProductSavingCount(
      saving,
      qualifyingPairs * 10,
      560
    );

    await new Promise((resolve) => {
      window.setTimeout(resolve, 2100);
    });

    strip.classList.remove(
      'is-celebrating'
    );

    celebration.setAttribute(
      'aria-hidden',
      'true'
    );

    tfvProductCelebrationRunning = false;

    /*
     * Apply any message that arrived while the celebration
     * was protected; otherwise settle into Savings Monitor.
     */
    if (tfvPendingBrainMessage) {
      const pending =
        tfvPendingBrainMessage;

      tfvPendingBrainMessage = null;

      window.requestAnimationFrame(() => {
        applyProductBrainMessage(
          pending.message,
          pending.event
        );
      });

      return;
    }

    sayVaultBrain(
      'savings-status',
      window.tfvCurrentProductVariant || {
        available: true
      },
      {
        qualifyingPairs,
        securedSaving:
          qualifyingPairs * 10
      }
    );
  }

  function getVaultBrainPayload(
    variant,
    additions = {}
  ) {
    const context =
      getProductPageContext();

    return {
      ...context,
      configuration:
        getSelectedProductConfiguration(),
      available:
        Boolean(
          variant &&
          variant.available
        ),
      productPath:
        window.location.pathname,
      source:
        'product',
      ...additions
    };
  }

  function applyProductBrainMessage(
    message,
    event
  ) {
    if (!message) return;

    if (
      message.effect ===
      'bundle-celebration'
    ) {
      runProductBundleCelebration(
        event.context.qualifyingPairs
      );

      return;
    }

    /*
     * Never let a cart refresh or secondary Brain event
     * tear down an active savings celebration.
     */
    if (tfvProductCelebrationRunning) {
      tfvPendingBrainMessage = {
        message,
        event
      };

      return;
    }

    const strip =
      document.getElementById(
        'product-intelligence-strip'
      );

    const signal =
      document.getElementById(
        'product-intelligence-strip-signal'
      );

    const title =
      document.getElementById(
        'product-intelligence-strip-title'
      );

    const detail =
      document.getElementById(
        'product-intelligence-strip-detail'
      );

    if (!strip) return;

    strip.classList.remove(
      'is-scanning',
      'is-verified',
      'is-bundle',
      'is-closed',
      'is-celebrating'
    );

    const toneClass = {
      scanning: 'is-scanning',
      verified: 'is-verified',
      bundle: 'is-bundle',
      closed: 'is-closed'
    }[message.tone];

    if (toneClass) {
      strip.classList.add(
        toneClass
      );
    }

    if (signal) {
      signal.textContent =
        message.signal;
    }

    if (title) {
      title.textContent =
        message.title;
    }

    if (detail) {
      detail.textContent =
        message.detail;
    }
  }

  function registerProductVaultBrainSurface() {
    if (
      !window.VaultOSBrain ||
      window.__tfvProductBrainSurfaceRegistered
    ) {
      return;
    }

    window.__tfvProductBrainSurfaceRegistered =
      true;

    window.VaultOSBrain.registerSurface(
      'product-operator',
      ({ message, event }) => {
        applyProductBrainMessage(
          message,
          event
        );
      }
    );
  }

  function sayVaultBrain(
    type,
    variant,
    additions = {}
  ) {
    registerProductVaultBrainSurface();

    if (
      window.VaultOSBrain &&
      typeof window.VaultOSBrain.emit ===
      'function'
    ) {
      return window.VaultOSBrain.emit(
        type,
        getVaultBrainPayload(
          variant,
          additions
        )
      );
    }

    return null;
  }

  function updateVaultOperator(state, variant) {
    const strip = document.getElementById(
      'product-intelligence-strip'
    );

    const signal = document.getElementById(
      'product-intelligence-strip-signal'
    );

    const title = document.getElementById(
      'product-intelligence-strip-title'
    );

    const detail = document.getElementById(
      'product-intelligence-strip-detail'
    );

    if (!strip) return;

    strip.classList.remove(
      'is-scanning',
      'is-verified',
      'is-bundle',
      'is-closed',
      'is-celebrating'
    );

    const configuration =
      getSelectedProductConfiguration();

    const context =
      getProductPageContext();

    if (state === 'scanning') {
      strip.classList.add('is-scanning');

      if (signal) signal.textContent = '•';
      if (title) title.textContent = 'Scanning Variant';

      if (detail) {
        detail.textContent =
          `Authenticating ${configuration}...`;
      }

      return;
    }

    if (state === 'checking') {
      strip.classList.add('is-scanning');

      if (signal) signal.textContent = '•';
      if (title) title.textContent = 'Checking Inventory';

      if (detail) {
        detail.textContent =
          'Confirming availability inside the Vault.';
      }

      return;
    }

    const available =
      Boolean(variant && variant.available);

    if (!available) {
      strip.classList.add('is-closed');

      if (signal) signal.textContent = '○';
      if (title) title.textContent = 'Vault Closed';

      if (detail) {
        detail.textContent = variant
          ? `Selected ${configuration} is currently sold out. Choose another size or colour to continue.`
          : `Selected ${configuration} is not currently offered. Choose another size or colour to continue.`;
      }

      return;
    }

    if (state === 'session-context') {
      const memory =
        updateVaultOperatorMemoryFromContext(
          context
        );

      strip.classList.add(
        context.qualifyingPairs > 0 ||
        context.vaultCareActive
          ? 'is-verified'
          : 'is-bundle'
      );

      if (signal) {
        signal.textContent =
          context.qualifyingPairs > 0 ||
          context.vaultCareActive
            ? '✓'
            : '●';
      }

      if (context.qualifyingPairs > 0) {
        if (title) {
          title.textContent =
            'Savings Restored';
        }

        if (detail) {
          detail.textContent =
            `${context.qualifyingPairs} ${
              context.qualifyingPairs === 1
                ? 'bundle is'
                : 'bundles are'
            } active · £${context.securedSaving} saving secured.`;
        }

        return;
      }

      if (context.vaultCareActive) {
        if (title) {
          title.textContent =
            'Protection Verified';
        }

        if (detail) {
          detail.textContent =
            'VaultCare is active for this secured session.';
        }

        return;
      }

      if (context.cartItems > 0) {
        if (title) {
          title.textContent =
            'Secured Session Restored';
        }

        if (detail) {
          detail.textContent =
            `${context.cartItems} ${
              context.cartItems === 1
                ? 'item is'
                : 'items are'
            } currently secured in your Vault.`;
        }

        return;
      }

      if (memory.productsViewed >= 3) {
        if (title) {
          title.textContent =
            'Product Comparison Active';
        }

        if (detail) {
          detail.textContent =
            `${memory.productsViewed} products reviewed this session. Vault Operator is tracking your selections.`;
        }

        return;
      }

      if (memory.productsViewed === 2) {
        if (title) {
          title.textContent =
            'Comparison Session Detected';
        }

        if (detail) {
          detail.textContent =
            'A second product is now under review. Bundle eligibility remains monitored.';
        }

        return;
      }

      if (title) {
        title.textContent =
          context.returningVisitor
            ? 'Welcome Back'
            : 'Welcome To The Vault';
      }

      if (detail) {
        detail.textContent =
          context.returningVisitor
            ? 'Your secure shopping session has been restored.'
            : 'Vault Operator is ready and monitoring this product.';
      }

      return;
    }

    if (state === 'welcome') {
      strip.classList.add('is-verified');

      if (signal) signal.textContent = '✓';

      if (title) {
        title.textContent = context.returningVisitor
          ? 'Welcome Back'
          : 'Welcome To The Vault';
      }

      if (detail) {
        detail.textContent = context.returningVisitor
          ? 'Resuming your secured shopping session.'
          : 'Vault Operator is ready and monitoring this product.';
      }

      return;
    }

    if (state === 'cart') {
      strip.classList.add('is-verified');

      if (signal) signal.textContent = '●';
      if (title) title.textContent = 'Secured Session';

      if (detail) {
        detail.textContent = context.cartItems > 0
          ? `${context.cartItems} ${context.cartItems === 1 ? 'item is' : 'items are'} already secured in your Vault.`
          : 'Your Vault is ready for its first secured item.';
      }

      return;
    }

    if (state === 'bundle') {
      strip.classList.add('is-bundle');

      if (signal) signal.textContent = '◇';
      if (title) title.textContent = 'Bundle Opportunity';

      if (detail) {
        detail.textContent =
          'Pair this with another qualifying Tee or Polo to secure a £10 saving.';
      }

      return;
    }

    if (state === 'savings-monitor') {
      const pairs =
        context.qualifyingPairs;

      const saving =
        context.securedSaving;

      const unpaired =
        context.unpairedItems;

      strip.classList.add(
        pairs > 0
          ? 'is-verified'
          : 'is-bundle'
      );

      if (signal) {
        signal.textContent =
          pairs > 0 ? '✓' : '◇';
      }

      if (title) {
        title.textContent =
          'Savings Monitor';
      }

      if (detail) {
        if (pairs > 0 && unpaired === 1) {
          detail.textContent =
            `${pairs} ${
              pairs === 1
                ? 'bundle is'
                : 'bundles are'
            } active · £${saving} saved. One qualifying item is waiting to be paired.`;
        } else if (pairs > 0) {
          detail.textContent =
            `${pairs} ${
              pairs === 1
                ? 'bundle is'
                : 'bundles are'
            } active · £${saving} saving secured.`;
        } else if (context.qualifyingItems === 1) {
          detail.textContent =
            '1 of 2 qualifying items secured. One more activates your first £10 saving.';
        } else {
          detail.textContent =
            'No active bundle yet. Secure two qualifying Tees or Polos to save £10.';
        }
      }

      return;
    }

    if (state === 'protection') {
      strip.classList.add(
        context.vaultCareActive
          ? 'is-verified'
          : 'is-bundle'
      );

      if (signal) {
        signal.textContent =
          context.vaultCareActive ? '✓' : '◇';
      }

      if (title) {
        title.textContent =
          context.vaultCareActive
            ? 'Protection Verified'
            : 'Protection Available';
      }

      if (detail) {
        detail.textContent =
          context.vaultCareActive
            ? 'VaultCare is active for your secured session.'
            : 'VaultCare can be activated from your cart before checkout.';
      }

      return;
    }

    if (state === 'secured') {
      strip.classList.add('is-verified');

      if (signal) signal.textContent = '✓';
      if (title) title.textContent = 'Inventory Secured';

      if (detail) {
        detail.textContent =
          'Item transferred to your Vault.';
      }

      return;
    }

    if (state === 'synchronising-savings') {
      strip.classList.add('is-scanning');

      if (signal) signal.textContent = '•';
      if (title) title.textContent = 'Synchronising Savings';

      if (detail) {
        detail.textContent =
          'Recalculating qualifying inventory and active Vault Bundles...';
      }

      return;
    }

    if (state === 'monitoring') {
      strip.classList.add('is-verified');

      if (signal) signal.textContent = '●';
      if (title) title.textContent = 'Operator Online';

      if (detail) {
        detail.textContent =
          'Monitoring product status, secured inventory and VaultCare.';
      }

      return;
    }

    strip.classList.add(
      context.offerEligible
        ? 'is-bundle'
        : 'is-verified'
    );

    if (signal) signal.textContent = '✓';
    if (title) title.textContent = 'Variant Verified';

    if (detail) {
      detail.textContent =
        `${configuration} is available and ready for secure checkout.`;
    }
  }

  function runProductVaultVerification(variant) {
    const status = document.getElementById(
      'product-vault-status'
    );

    const statusTitle = document.getElementById(
      'product-vault-status-title'
    );

    const statusText = document.getElementById(
      'product-vault-status-text'
    );

    const variantCheck = document.getElementById(
      'product-vault-variant-check'
    );

    const inventoryIcon = document.getElementById(
      'product-vault-inventory-icon'
    );

    const inventoryCheck = document.getElementById(
      'product-vault-inventory-check'
    );

    if (!status) return;

    clearVaultOperatorTimers();

    const configuration =
      getSelectedProductConfiguration();

    sayVaultBrain(
      'variant-scanning',
      variant
    );

    status.classList.remove(
      'is-verified',
      'product-vault-status--closed'
    );

    status.classList.add('is-scanning');

    if (statusTitle) {
      statusTitle.textContent =
        'Scanning Variant';
    }

    if (statusText) {
      statusText.textContent =
        'Verifying';
    }

    if (variantCheck) {
      variantCheck.textContent =
        configuration;
    }

    if (inventoryCheck) {
      inventoryCheck.textContent =
        'Checking availability';
    }

    queueVaultOperatorUpdate(() => {
      sayVaultBrain(
        'variant-checking',
        variant
      );
    }, 260);

    window.clearTimeout(
      window.tfvProductVaultStatusTimer
    );

    window.tfvProductVaultStatusTimer =
      window.setTimeout(() => {
        const available =
          Boolean(variant && variant.available);

        status.classList.remove('is-scanning');

        status.classList.toggle(
          'is-verified',
          available
        );

        status.classList.toggle(
          'product-vault-status--closed',
          !available
        );

        if (statusTitle) {
          statusTitle.textContent = available
            ? 'Variant Verified'
            : 'Vault Closed';
        }

        if (statusText) {
          statusText.textContent = available
            ? 'Available'
            : 'Sold Out';
        }

        if (variantCheck) {
          variantCheck.textContent = available
            ? `${configuration} verified`
            : `${configuration} selected`;
        }

        if (inventoryIcon) {
          inventoryIcon.textContent = available
            ? '✓'
            : '○';

          inventoryIcon.classList.toggle(
            'product-vault-status__check--unavailable',
            !available
          );
        }

        if (inventoryCheck) {
          inventoryCheck.textContent = available
            ? 'Ready to secure'
            : 'Currently sold out';
        }

        sayVaultBrain(
          available
            ? 'variant-verified'
            : 'variant-unavailable',
          variant,
          {
            available
          }
        );

        /*
         * Event-driven Operator:
         * variant verification now settles here and remains
         * visible until the customer performs another action.
         */
        if (!available) return;
      }, 620);
  }

  function selectOption(button, value) {
    const optionGroup = button.closest('.selector-wrapper');
    const container = button.closest('.option-buttons');

    if (!container || !optionGroup) return;

    container
      .querySelectorAll('.option-btn')
      .forEach((optionButton) => {
        const selected = optionButton === button;

        optionButton.classList.toggle(
          'selected',
          selected
        );

        optionButton.setAttribute(
          'aria-pressed',
          selected ? 'true' : 'false'
        );
      });

    const optionPosition =
      optionGroup.dataset.optionPosition;

    const selectedLabel = document.querySelector(
      '[data-selected-option="' +
      optionPosition +
      '"]'
    );

    if (selectedLabel) {
      selectedLabel.textContent = value;
    }

    updateVariant();
  }

  function updateVariant() {
    const selectedValues = Array.from(
      document.querySelectorAll('.option-btn.selected')
    ).map((button) => button.dataset.value);

    const variants = {{ product.variants | json }};

    const match = variants.find((variant) => {
      return selectedValues.every((value, index) => {
        return variant['option' + (index + 1)] === value;
      });
    });

    if (!match) {
  const addButton = document.querySelector(
    '.add-to-cart-btn'
  );

  const addButtonText = document.getElementById(
    'add-to-cart-text'
  );

  if (addButton) {
    addButton.disabled = true;
  }

  if (addButtonText) {
    addButtonText.textContent =
      'Vault Closed';
  }

  runProductVaultVerification(null);

  return;
}

    const variantInput = document.getElementById(
      'variant-id'
    );

    const addButton = document.querySelector(
      '.add-to-cart-btn'
    );

    const addButtonText = document.getElementById(
      'add-to-cart-text'
    );

    const currentPrice = document.getElementById(
      'product-current-price'
    );

    const comparePrice = document.getElementById(
      'product-compare-price'
    );

    const buttonPrice = document.getElementById(
      'button-product-price'
    );

    if (variantInput) {
      variantInput.value = match.id;

      variantInput.dispatchEvent(
        new Event('change', {
          bubbles: true
        })
      );
    }

    if (currentPrice) {
      currentPrice.textContent = formatMoney(
        match.price
      );
    }

    if (buttonPrice) {
      buttonPrice.textContent = formatMoney(
        match.price
      );
    }

    if (comparePrice) {
      if (
        match.compare_at_price &&
        match.compare_at_price > match.price
      ) {
        comparePrice.textContent = formatMoney(
          match.compare_at_price
        );

        comparePrice.hidden = false;
      } else {
        comparePrice.hidden = true;
      }
    }

    if (addButton && addButtonText) {
      addButton.disabled = !match.available;

      addButtonText.textContent = match.available
        ? 'Secure Item'
        : 'Vault Closed';
    }

    window.tfvCurrentProductVariant = match;

    runProductVaultVerification(match);

    if (
      match.featured_image &&
      match.featured_image.src
    ) {
      const featuredFilename =
        match.featured_image.src
          .split('?')[0]
          .split('/')
          .pop()
          .split('.')[0];

      document
        .querySelectorAll(
          '.product-gallery__thumb[data-image-filename]'
        )
        .forEach((thumb) => {
          if (
            thumb.dataset.imageFilename ===
            featuredFilename
          ) {
            const thumbnailImage =
              thumb.querySelector('img');

            if (!thumbnailImage) return;

            let largeSource =
              thumbnailImage.src;

            largeSource = largeSource.replace(
              /width=\d+/,
              'width=1600'
            );

            changeImage(
              largeSource,
              thumb
            );
          }
        });
    }

    const newUrl =
      window.location.pathname +
      '?variant=' +
      match.id;

    window.history.replaceState(
      {},
      '',
      newUrl
    );
  }

  function formatMoney(cents) {
    return new Intl.NumberFormat(
      'en-GB',
      {
        style: 'currency',
        currency: 'GBP'
      }
    ).format(cents / 100);
  }

  function toggleProductDescription(button) {
    const panel = button.closest(
      '.product-description-panel'
    );

    if (!panel) return;

    const content = panel.querySelector(
      '.product-description-panel__content'
    );

    const symbol = panel.querySelector(
      '.product-description-panel__symbol'
    );

    if (!content) return;

    const collapsed =
      content.classList.toggle('is-collapsed');

    button.setAttribute(
      'aria-expanded',
      collapsed ? 'false' : 'true'
    );

    if (symbol) {
      symbol.textContent = collapsed ? '+' : '−';
    }
  }

  function showProductSecuredToast() {
    const toast = document.getElementById(
      'product-secured-toast'
    );

    if (!toast) return;

    toast.classList.add('is-visible');

    clearTimeout(
      window.tfvProductToastTimer
    );

    window.tfvProductToastTimer = setTimeout(() => {
      toast.classList.remove('is-visible');
    }, 2800);
  }

  function synchroniseProductPageWithVaultCart(
    detail = {}
  ) {
    const page =
      document.querySelector(
        '.tfv-product-page'
      );

    if (!page) return;

    const cart =
      detail.cart || {};

    const qualifyingItems =
      Math.max(
        0,
        Number(detail.qualifyingItems) || 0
      );

    const qualifyingPairs =
      Math.max(
        0,
        Number(detail.qualifyingPairs) || 0
      );

    const securedSaving =
      Math.max(
        0,
        Number(detail.securedSaving) || 0
      );

    const customerItems =
      Math.max(
        0,
        Number(detail.customerItems) ||
        Number(cart.item_count) ||
        0
      );

    page.dataset.tfvCartItems =
      String(customerItems);

    page.dataset.tfvQualifyingItems =
      String(qualifyingItems);

    page.dataset.tfvQualifyingPairs =
      String(qualifyingPairs);

    page.dataset.tfvUnpairedItems =
      String(qualifyingItems % 2);

    page.dataset.tfvSecuredSaving =
      String(securedSaving);

    if (
      typeof detail.vaultCareActive !==
      'undefined'
    ) {
      page.dataset.tfvVaultcareActive =
        detail.vaultCareActive
          ? 'true'
          : 'false';
    }
  }

  document.addEventListener(
    'tfv:vault-updated',
    (event) => {
      synchroniseProductPageWithVaultCart(
        event.detail || {}
      );
    }
  );

  function focusVaultOperator() {
    const operator =
      document.getElementById(
        'product-intelligence-strip'
      );

    if (!operator) {
      return Promise.resolve();
    }

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

    const header =
      document.querySelector(
        'header, .shopify-section-header-sticky, .header-wrapper'
      );

    const headerHeight =
      header
        ? Math.min(
            header.getBoundingClientRect().height,
            140
          )
        : 0;

    const offset =
      Math.max(
        92,
        headerHeight + 24
      );

    const targetPosition =
      operator.getBoundingClientRect().top +
      window.scrollY -
      offset;

    window.scrollTo({
      top: Math.max(
        0,
        targetPosition
      ),
      behavior:
        reducedMotion
          ? 'auto'
          : 'smooth'
    });

    if (reducedMotion) {
      return Promise.resolve();
    }

    return new Promise((resolve) => {
      window.setTimeout(
        resolve,
        620
      );
    });
  }

  function keepVaultCartDrawersClosed() {
    const drawerIds = [
      'cart-drawer',
      'cart-drawer-vaultos'
    ];

    drawerIds.forEach((id) => {
      const drawer =
        document.getElementById(id);

      if (!drawer) return;

      drawer.classList.remove(
        'is-open',
        'active',
        'open'
      );

      drawer.setAttribute(
        'aria-hidden',
        'true'
      );

      drawer.style.display = 'none';
    });

    document.body.classList.remove(
      'drawer-open',
      'cart-drawer-open',
      'overflow-hidden'
    );
  }

  function getVaultCartIcon() {
    const selectors = [
      '[onclick*="cart-drawer-vaultos"]',
      '[onclick*="cart-drawer"]',
      '.header__icon--cart',
      '#cart-icon-bubble',
      '[data-cart-toggle]',
      '[data-cart-drawer-trigger]',
      '.site-header__cart',
      '.header-cart-icon'
    ];

    for (const selector of selectors) {
      const element =
        document.querySelector(selector);

      if (element) {
        return element;
      }
    }

    return null;
  }

  function animateVaultCartIcon() {
    const cartIcon =
      getVaultCartIcon();

    if (!cartIcon) return;

    cartIcon.classList.remove(
      'tfv-cart-icon-secured'
    );

    void cartIcon.offsetWidth;

    cartIcon.classList.add(
      'tfv-cart-icon-secured'
    );

    window.clearTimeout(
      window.tfvCartIconAnimationTimer
    );

    window.tfvCartIconAnimationTimer =
      window.setTimeout(() => {
        cartIcon.classList.remove(
          'tfv-cart-icon-secured'
        );
      }, 820);
  }

  function updateHeaderCartCount() {
    return fetch(
      window.Shopify.routes.root + 'cart.js',
      {
        credentials: 'same-origin'
      }
    )
      .then((response) => response.json())
      .then((cart) => {
        const countElements =
          document.querySelectorAll(
            '.cart-count-badge, .cart-count, #cart-icon-bubble span, [data-cart-count], .header__cart-count'
          );

        countElements.forEach((element) => {
          element.textContent = cart.item_count;

          if (
            element.classList.contains(
              'cart-count-badge'
            )
          ) {
            element.dataset.count =
              cart.item_count;
          }
        });

        return cart;
      });
  }

  function refreshCartDrawer() {
    return fetch(window.location.href)
      .then((response) => response.text())
      .then((text) => {
        const html = new DOMParser()
          .parseFromString(
            text,
            'text/html'
          );

        const refreshedDrawer =
          html.getElementById('cart-drawer');

        const currentDrawer =
          document.getElementById('cart-drawer');

        if (
          refreshedDrawer &&
          currentDrawer
        ) {
          currentDrawer.innerHTML =
            refreshedDrawer.innerHTML;
        }
      });
  }

  /* Preload product images for iOS Safari */

  window.addEventListener(
    'DOMContentLoaded',
    function () {
      const initialVariant =
        {{ selected_variant | json }};

      registerProductVaultBrainSurface();

      queueVaultOperatorUpdate(() => {
        sayVaultBrain(
          'session-start',
          initialVariant
        );

        markProductVisitorKnown();
      }, 700);

      queueVaultOperatorUpdate(() => {
        if (
          initialVariant &&
          initialVariant.available
        ) {
          sayVaultBrain(
            'savings-status',
            initialVariant
          );
        }
      }, 3200);

      const imageUrls = [
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            "{{ media | image_url: width: 1600 }}"{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ].filter(Boolean);

      imageUrls.forEach((url) => {
        fetch(url, {
          method: 'GET',
          mode: 'no-cors',
          cache: 'force-cache'
        }).catch(() => {});
      });
    }
  );

  window.tfvCurrentProductVariant =
    {{ selected_variant | json }};

  const productForm = document.getElementById(
    'product-form'
  );

  if (productForm) {
    productForm.addEventListener(
      'submit',
      function (event) {
        event.preventDefault();

        const form = this;

        const submitButton =
          form.querySelector('.add-to-cart-btn');

        const buttonText =
          document.getElementById(
            'add-to-cart-text'
          );

        const message =
          document.getElementById(
            'product-form-message'
          );

        if (
          !submitButton ||
          submitButton.disabled
        ) {
          return;
        }

        const normalText = 'Secure Item';

        submitButton.disabled = true;
        submitButton.classList.add(
          'tfv-item-securing'
        );

        if (buttonText) {
          buttonText.textContent =
            'Securing Item...';
        }

        if (message) {
          message.textContent =
            'Authenticating inventory...';

          message.classList.remove('is-error');
        }

        const formData = new FormData(form);

        fetch(
          window.Shopify.routes.root +
          'cart/add.js',
          {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json'
            }
          }
        )
          .then((response) => {
            if (!response.ok) {
              return response
                .json()
                .then((errorData) => {
                  throw new Error(
                    errorData.description ||
                    'Unable to secure item'
                  );
                });
            }

            return response.json();
          })
          .then(async (addedItem) => {
            const page = document.querySelector(
              '.tfv-product-page'
            );

            const contextBefore =
              getProductPageContext();

            const productQualifies =
              document.getElementById(
                'product-intelligence-strip'
              )?.dataset.offerEligible === 'true';

            if (page) {
              page.dataset.tfvCartItems =
                String(
                  contextBefore.cartItems + 1
                );
            }

            let nextQualifyingItems =
              contextBefore.qualifyingItems;

            if (productQualifies) {
              nextQualifyingItems += 1;
            }

            const nextQualifyingPairs =
              Math.floor(
                nextQualifyingItems / 2
              );

            const bundleJustActivated =
              nextQualifyingPairs >
              contextBefore.qualifyingPairs;

            updateProductBundleContext(
              nextQualifyingItems,
              nextQualifyingPairs
            );

            updateVaultOperatorMemoryFromContext(
              getProductPageContext()
            );

            submitButton.classList.remove(
              'tfv-item-securing'
            );

            if (buttonText) {
              buttonText.textContent =
                'Item Secured ✓';
            }

            if (message) {
              message.textContent =
                'Successfully added to your vault.';
            }

            keepVaultCartDrawersClosed();
            animateVaultCartIcon();
            showProductSecuredToast();

            clearVaultOperatorTimers();

            /*
             * Bring the Vault Operator into view before
             * any post-add messages or bundle celebration begin.
             */
            await focusVaultOperator();

            sayVaultBrain(
              'inventory-secured',
              window.tfvCurrentProductVariant || {
                available: true
              }
            );

            queueVaultOperatorUpdate(() => {
              sayVaultBrain(
                'savings-sync',
                window.tfvCurrentProductVariant || {
                  available: true
                }
              );
            }, 650);

            queueVaultOperatorUpdate(() => {
              sayVaultBrain(
                bundleJustActivated
                  ? 'bundle-unlocked'
                  : 'savings-status',
                window.tfvCurrentProductVariant || {
                  available: true
                },
                {
                  qualifyingItems:
                    nextQualifyingItems,
                  qualifyingPairs:
                    nextQualifyingPairs,
                  securedSaving:
                    nextQualifyingPairs * 10,
                  bundleUnlocked:
                    bundleJustActivated
                }
              );
            }, 1450);

            if (
              typeof window.tfvShowHeaderStatus ===
              'function'
            ) {
              window.tfvShowHeaderStatus(
                'Item Secured'
              );
            }

            return Promise.all([
              refreshCartDrawer(),
              updateHeaderCartCount()
            ]);
          })
          .then(() => {
            keepVaultCartDrawersClosed();

            setTimeout(() => {
              if (buttonText) {
                buttonText.textContent =
                  normalText;
              }

              submitButton.disabled = false;
            }, 1800);
          })
          .catch((error) => {
            console.error(
              'Error securing product:',
              error
            );

            submitButton.classList.remove(
              'tfv-item-securing'
            );

            if (buttonText) {
              buttonText.textContent =
                'Try Again';
            }

            if (message) {
              message.textContent =
                error.message ||
                'Unable to add this item.';

              message.classList.add('is-error');
            }

            setTimeout(() => {
              if (buttonText) {
                buttonText.textContent =
                  normalText;
              }

              submitButton.disabled = false;
            }, 2200);
          });
      }
    );
  }
</script>


     PURCHASE
  ========================================= */

  .purchase-section {
    display: grid;
    gap: 10px;
    margin-top: 25px;
  }

  .add-to-cart-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    width: 100%;
    min-height: 58px;
    padding: 15px 18px;
    overflow: hidden;
    color: #080808;
    background: linear-gradient(
      135deg,
      #ad7d3d,
      #f7dc94 52%,
      #9e6d2e
    );
    border: 1px solid rgba(247, 220, 148, 0.75);
    border-radius: 9px;
    cursor: pointer;
    box-shadow:
      0 15px 34px rgba(0, 0, 0, 0.33),
      0 0 28px rgba(197, 157, 95, 0.12);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      box-shadow 220ms ease,
      filter 220ms ease;
  }

  .add-to-cart-btn::before {
    content: "";
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: -45%;
    width: 28%;
    opacity: 0;
    transform: skewX(-18deg);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.55),
      transparent
    );
  }

  .add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.42),
      0 0 38px rgba(197, 157, 95, 0.23);

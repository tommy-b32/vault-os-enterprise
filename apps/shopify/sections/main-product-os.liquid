      );
    }

    45% {
      filter: drop-shadow(
        0 0 10px rgba(247, 220, 148, 0.75)
      );
    }

    100% {
      filter: drop-shadow(
        0 0 0 rgba(197, 157, 95, 0)
      );
    }
  }

  @keyframes tfvCartIconCheck {
    0% {
      opacity: 0;
      transform:
        translateY(5px)
        scale(0.45);
    }

    45% {
      opacity: 1;
      transform:
        translateY(0)
        scale(1.12);
    }

    72% {
      transform:
        translateY(0)
        scale(0.96);
    }

    100% {

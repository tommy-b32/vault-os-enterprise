  .product-vault-status--closed {
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }

  .product-vault-status--closed .product-vault-status__led {
    background: rgba(255, 255, 255, 0.35);
    box-shadow: none;
